{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./supabase/.env)",
      "Read(./supabase/functions/.env)",
      "Read(**/*.p8)",
      "Read(**/*.p12)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.mobileprovision)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/service-account*.json)",
      "Read(**/google-services-key*.json)"
    ]
  }
}
