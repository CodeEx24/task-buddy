# Supabase CLI local state (same entries `supabase init` generates).
# .temp holds the CLI's version-check cache and, after `supabase link`, the linked project ref.
.branches
.temp

# dotenvx (Supabase CLI secret files)
.env.keys
.env.local
.env.*.local

# TB-22: `deno check` writes a lockfile in a newer format than the Edge Runtime's Deno; versions are
# pinned exactly in each function's deno.json instead.
functions/**/deno.lock
