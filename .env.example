# Task Buddy app environment (TB-19). Copy to .env.local, or run
#   npx eas-cli env:pull --environment development
# Every value here is PUBLIC (it ships inside the app). Never put a Supabase secret key
# (sb_secret_...), a legacy service_role key or a database password in any EXPO_PUBLIC_* variable.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<from-dashboard>
# TB-37 crash reporting. The DSN is public (it only lets the app send events). Leave it empty to
# keep Sentry off. The Sentry auth token is a SECRET: EAS secret SENTRY_AUTH_TOKEN only, never here.
EXPO_PUBLIC_SENTRY_DSN=
